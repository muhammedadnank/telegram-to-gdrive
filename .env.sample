# ─── Telegram ───────────────────────────────────────────────
# Get from https://t.me/botfather
BOT_TOKEN=

# Get from https://my.telegram.org/apps
APP_ID=
API_HASH=

# Your Telegram User ID (space-separated for multiple users)
# Get from https://t.me/userinfobot
SUDO_USERS=

# ─── MongoDB ────────────────────────────────────────────────
# Get from https://www.mongodb.com/atlas (Free M0 tier)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=

# ─── Google Drive ───────────────────────────────────────────
# Get from https://console.cloud.google.com/
# Create OAuth 2.0 credentials (Desktop app type)
G_DRIVE_CLIENT_ID=
G_DRIVE_CLIENT_SECRET=

# ─── OAuth2 Redirect URI ────────────────────────────────────
# Only needed if deploying to Render or a custom server with web OAuth callback.
# Format: https://your-app.onrender.com/oauth2callback
# Leave blank to use Google's out-of-band (OOB) flow (copy-paste code).
REDIRECT_URI=

# ─── Optional ───────────────────────────────────────────────
# Custom download directory (must end with /)
DOWNLOAD_DIRECTORY=./downloads/

# Your Render service external URL (used for /health endpoint only)
# Format: https://your-app.onrender.com
RENDER_EXTERNAL_URL=
