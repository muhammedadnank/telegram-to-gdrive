# ─── Telegram ───────────────────────────────────────────────
# Get from https://t.me/botfather
BOT_TOKEN=

# Get from https://my.telegram.org/apps
APP_ID=
API_HASH=

# Space-separated Telegram User IDs of admins
SUDO_USERS=

# ─── MongoDB ────────────────────────────────────────────────
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=

# ─── Google Drive ───────────────────────────────────────────
# Paste the entire contents of your service account JSON key here (as a single line)
G_DRIVE_SERVICE_ACCOUNT_JSON=

# OAuth 2.0 Credentials (needed only for Telegram -> Google Drive user uploads)
# Create at https://console.cloud.google.com/
G_DRIVE_CLIENT_ID=
G_DRIVE_CLIENT_SECRET=
REDIRECT_URI=

# ─── Optional ───────────────────────────────────────────────
MAX_WORKERS=3
POLL_INTERVAL=45
DOWNLOAD_DIRECTORY=./downloads/
FAILED_DIRECTORY=./failed/
WEB_PASSWORD=

